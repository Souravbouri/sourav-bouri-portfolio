# Copy this file to ".env" and fill in your real values.
# ".env" is already in .gitignore -- it will never be committed
# or shown to visitors of your site.

# The Gmail address that will SEND the notification email.
# This can be a dedicated Gmail account, or your normal one.
MAIL_USERNAME=youraddress@gmail.com

# A Gmail "App Password" -- NOT your normal Gmail password.
# See README.md for how to generate one.
MAIL_PASSWORD=your16characterapppassword

# The address that should actually RECEIVE messages from the
# contact form. Usually the same as MAIL_USERNAME, but you can
# point it anywhere.
MAIL_TO=youraddress@gmail.com

# Only change these if you're not using Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
